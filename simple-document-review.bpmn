<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SimpleDocumentReview" targetNamespace="https://example.com/bpmn/simple-document-review">
  <bpmn:process id="Process_SimpleDocumentReview" name="Simple Document Review" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DocumentSubmitted">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitDocument" name="Submit Document">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Review</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewDocument" name="Review Document">
      <bpmn:incoming>Flow_Submit_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_DocumentReviewed" name="Document Reviewed">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_DocumentSubmitted" targetRef="Task_SubmitDocument" />
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Task_SubmitDocument" targetRef="Task_ReviewDocument" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_ReviewDocument" targetRef="EndEvent_DocumentReviewed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SimpleDocumentReview">
    <bpmndi:BPMNPlane id="BPMNPlane_SimpleDocumentReview" bpmnElement="Process_SimpleDocumentReview">
      <bpmndi:BPMNShape id="Shape_StartEvent_DocumentSubmitted" bpmnElement="StartEvent_DocumentSubmitted">
        <dc:Bounds x="100" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SubmitDocument" bpmnElement="Task_SubmitDocument">
        <dc:Bounds x="190" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewDocument" bpmnElement="Task_ReviewDocument">
        <dc:Bounds x="370" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_DocumentReviewed" bpmnElement="EndEvent_DocumentReviewed">
        <dc:Bounds x="560" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_Submit" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="136" y="170" />
        <di:waypoint x="190" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Submit_Review" bpmnElement="Flow_Submit_Review">
        <di:waypoint x="310" y="170" />
        <di:waypoint x="370" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Review_End" bpmnElement="Flow_Review_End">
        <di:waypoint x="490" y="170" />
        <di:waypoint x="560" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
