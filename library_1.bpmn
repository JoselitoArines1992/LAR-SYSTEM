        <dc:Bounds x="940" y="45" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_ReceiveUnavailable" bpmnElement="S_ReceiveUnavailable">
        <dc:Bounds x="510" y="145" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_EndUnavailable" bpmnElement="S_EndUnavailable">
        <dc:Bounds x="710" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_ReceiveApproval" bpmnElement="S_ReceiveApproval">
        <dc:Bounds x="510" y="230" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_ReceiveBook" bpmnElement="S_ReceiveBook">
        <dc:Bounds x="690" y="230" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_UseBook" bpmnElement="S_UseBook">
        <dc:Bounds x="870" y="225" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Return" bpmnElement="S_Return">
        <dc:Bounds x="1050" y="230" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_End" bpmnElement="S_End">
        <dc:Bounds x="1240" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Start" bpmnElement="L_Start">
        <dc:Bounds x="170" y="530" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_ReceiveRequest" bpmnElement="L_ReceiveRequest">
        <dc:Bounds x="240" y="508" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Available" bpmnElement="L_Available">
        <dc:Bounds x="430" y="523" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Unavailable" bpmnElement="L_Unavailable">
        <dc:Bounds x="550" y="405" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_EndUnavailable" bpmnElement="L_EndUnavailable">
        <dc:Bounds x="750" y="427" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Validate" bpmnElement="L_Validate">
        <dc:Bounds x="590" y="610" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_RequestCorrection" bpmnElement="L_RequestCorrection">
        <dc:Bounds x="710" y="540" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_ReceiveCorrected" bpmnElement="L_ReceiveCorrected">
        <dc:Bounds x="910" y="540" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Record" bpmnElement="L_Record">
        <dc:Bounds x="740" y="700" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_L_Approve" bpmnElement="L_Approve">
        <dc:Bounds x="940" y="700" width="130" height="80" />
      </bpmndi:BPMNShape>
