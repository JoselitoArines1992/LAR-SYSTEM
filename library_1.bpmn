      <bpmndi:BPMNShape id="Shape_L_End" bpmnElement="L_End">
        <dc:Bounds x="1730" y="722" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Correct_Start" bpmnElement="S_Correct_Start">
        <dc:Bounds x="705" y="58" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Correct_Work" bpmnElement="S_Correct_Work">
        <dc:Bounds x="760" y="45" width="110" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_Correct_End" bpmnElement="S_Correct_End">
        <dc:Bounds x="890" y="58" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_S1" bpmnElement="SF_S1">
        <di:waypoint x="206" y="155" />
        <di:waypoint x="240" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_S2" bpmnElement="SF_S2">
        <di:waypoint x="360" y="155" />
        <di:waypoint x="410" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_SC" bpmnElement="SF_SC">
        <di:waypoint x="435" y="130" />
        <di:waypoint x="435" y="75" />
        <di:waypoint x="510" y="75" />
        <bpmndi:BPMNLabel id="Label_SF_SC">
          <dc:Bounds x="610" y="128" width="115" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_SC2" bpmnElement="SF_SC2">
        <di:waypoint x="640" y="75" />
        <di:waypoint x="690" y="75" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_SC3" bpmnElement="SF_SC3">
        <di:waypoint x="900" y="75" />
        <di:waypoint x="940" y="75" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_SC4" bpmnElement="SF_SC4">
        <di:waypoint x="1070" y="75" />
        <di:waypoint x="1100" y="75" />
        <di:waypoint x="1100" y="15" />
        <di:waypoint x="435" y="15" />
        <di:waypoint x="435" y="130" />
      </bpmndi:BPMNEdge>
